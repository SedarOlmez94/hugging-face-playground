{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build Clive Extension",
			"type": "shell",
			"command": "npm run compile",
			"options": {
				"cwd": "${workspaceFolder}/clive-vscode"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"reveal": "silent",
				"panel": "shared"
			},
			"problemMatcher": ["$tsc", "$esbuild-watch"]
		}
	]
}
